<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>$(MeltPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MELT" Version="$(MeltPackageVersion)" />
    <PackageReference Include="MELT.Serilog" Version="$(MeltPackageVersion)" />
    <PackageReference Include="MELT.Xunit" Version="$(MeltPackageVersion)" Aliases="xunit2" />
    <PackageReference Include="MELT.Xunit.v3" Version="$(MeltPackageVersion)" Aliases="xunit3" />
    <Compile Include="../Program.cs" Link="Program.cs" />
  </ItemGroup>
</Project>
