<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <Authors>Alessio Franceschelli</Authors>
    <PackageTags>Logging;Log;Logs;Microsoft.Extensions.Logging;Testing</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alefranz/MELT</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/alefranz/MELT.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/alefranz/MELT/blob/main/docs/RELEASE-NOTES-v2.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../logo.png" Pack="true" PackagePath="" />
    <None Include="$(BaseIntermediateOutputPath)package-readme/README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="GeneratePackageReadme" BeforeTargets="GenerateNuspec">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)../docs/package-readme.md">
      <Output TaskParameter="Lines" ItemName="PackageReadmeTemplateLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <PackageReadmeLine Include="@(PackageReadmeTemplateLine)">
        <RenderedLine>$([System.String]::Copy('%(Identity)').Replace('__MELT_VERSION__', '$(Version)'))</RenderedLine>
      </PackageReadmeLine>
    </ItemGroup>
    <WriteLinesToFile
      File="$(BaseIntermediateOutputPath)package-readme/README.md"
      Lines="@(PackageReadmeLine->'%(RenderedLine)')"
      Overwrite="true" />
  </Target>

</Project>
