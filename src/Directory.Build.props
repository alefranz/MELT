<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <Authors>Alessio Franceschelli</Authors>
    <PackageTags>Logging;Log;Logs;Microsoft.Extensions.Logging;Testing</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alefranz/MELT</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/alefranz/MELT.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/alefranz/MELT/blob/main/docs/RELEASE-NOTES-v2.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    <WarningsNotAsErrors>$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../logo.png" Pack="true" PackagePath="" />
    <None Include="$(BaseIntermediateOutputPath)package-readme/README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="GeneratePackageReadme"
          BeforeTargets="GenerateNuspec"
          DependsOnTargets="InitializeSourceControlInformation;_InitializeNuspecRepositoryInformationProperties">
    <PropertyGroup>
      <_MeltPackageCommit Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</_MeltPackageCommit>
      <_MeltPackageCommit Condition="'$(_MeltPackageCommit)' == '' and '$(SourceRevisionId)' != ''">$(SourceRevisionId)</_MeltPackageCommit>
      <_MeltPackageRef Condition="'$(_MeltPackageCommit)' != ''">$(_MeltPackageCommit)</_MeltPackageRef>
      <_MeltPackageRef Condition="'$(_MeltPackageRef)' == ''">main</_MeltPackageRef>
      <PackageReleaseNotes>https://github.com/alefranz/MELT/blob/$(_MeltPackageRef)/docs/RELEASE-NOTES-v2.md</PackageReleaseNotes>
      <_PackageReadmeDirectory>$(BaseIntermediateOutputPath)package-readme</_PackageReadmeDirectory>
      <_PackageReadmeOutputPath>$(_PackageReadmeDirectory)/README.md</_PackageReadmeOutputPath>
      <_PackageReadmeContent>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../docs/package-readme.md').Replace('__MELT_VERSION__', '$(PackageVersion)').Replace('__MELT_COMMIT__', '$(_MeltPackageRef)').TrimEnd())))</_PackageReadmeContent>
    </PropertyGroup>
    <MakeDir Directories="$(_PackageReadmeDirectory)" />
    <WriteLinesToFile
      File="$(_PackageReadmeOutputPath)"
      Lines="$(_PackageReadmeContent)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
